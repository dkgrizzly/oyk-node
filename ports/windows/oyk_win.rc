#include <windows.h>
#include "resource.h"

IDR_MAINMENU MENU
BEGIN
    POPUP "&Node"
    BEGIN
        MENUITEM "&Allow Incoming Connections",  IDM_ALLOW_INCOMING
        MENUITEM "&Deny Incoming Connections",   IDM_DENY_INCOMING
        MENUITEM SEPARATOR
        MENUITEM "&Local Terminal...",           IDM_TERMINAL
        MENUITEM "Approve Incoming &Files...",   IDM_APPROVE_FILES
        MENUITEM "&Settings...",                 IDM_SETTINGS
        MENUITEM "&Terminate Connection...",     IDM_TERMINATE
        MENUITEM "&Ban / Unban Callsign...",     IDM_BAN
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                        IDM_EXIT
    END
END

IDD_TERMINATE DIALOG 20, 20, 260, 140
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Terminate Active Connection"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Select an active connection to terminate:", -1, 8, 8, 244, 10
    LISTBOX         IDC_TERM_LIST, 8, 22, 244, 88, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "Terminate", IDOK, 134, 118, 56, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 196, 118, 56, 14
END

IDD_BAN DIALOG 20, 20, 296, 224
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ban / Unban Callsign (banlist.cfg)"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Callsign:", -1, 8, 10, 40, 10
    EDITTEXT        IDC_BAN_CALL, 52, 8, 84, 12, ES_UPPERCASE | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    CHECKBOX        "Hard Ban", IDC_BAN_HARD, 146, 9, 55, 10, BS_AUTOCHECKBOX | WS_TABSTOP
    CHECKBOX        "Appeal Allowed", IDC_BAN_APPEAL, 206, 9, 78, 10, BS_AUTOCHECKBOX | WS_TABSTOP

    LTEXT           "Lift At:", -1, 8, 28, 40, 10
    EDITTEXT        IDC_BAN_LIFT, 52, 26, 94, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "(permanent, 30m, 12h, 7d, YYYY-MM-DD)", -1, 152, 28, 138, 10

    LTEXT           "Reason:", -1, 8, 46, 40, 10
    EDITTEXT        IDC_BAN_REASON, 52, 44, 236, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP

    PUSHBUTTON      "&Ban Callsign", IDC_BAN_ADD, 52, 62, 72, 14
    PUSHBUTTON      "&Unban Selected", IDC_BAN_REMOVE, 132, 62, 76, 14

    LTEXT           "Active Bans:", -1, 8, 82, 120, 10
    LISTBOX         IDC_BAN_LIST, 8, 94, 280, 102, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP

    DEFPUSHBUTTON   "Close", IDCANCEL, 232, 202, 56, 14
END

IDD_TERMINAL DIALOG 12, 12, 360, 232
STYLE WS_OVERLAPPEDWINDOW
CAPTION "OYK Local Packet Terminal (YAPP)"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Port:", IDC_LTERM_LBL_PORT, 6, 9, 20, 10
    COMBOBOX        IDC_LTERM_PORT, 28, 7, 56, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Target:", IDC_LTERM_LBL_TGT, 88, 9, 26, 10
    EDITTEXT        IDC_LTERM_TARGET, 116, 7, 94, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "&Connect", IDC_LTERM_CONNECT, 214, 6, 44, 14
    PUSHBUTTON      "&Disc", IDC_LTERM_DISC, 261, 6, 30, 14
    PUSHBUTTON      "&YAPP Up...", IDC_LTERM_UPLOAD, 294, 6, 60, 14

    EDITTEXT        IDC_LTERM_OUTPUT, 6, 24, 348, 166, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP

    LTEXT           "Disconnected (YAPP downloads save to incoming\\<CALL-SSID>\\)", IDC_LTERM_STATUS, 6, 193, 284, 10
    PUSHBUTTON      "Abort &YAPP", IDC_LTERM_ABORT, 294, 191, 60, 14

    EDITTEXT        IDC_LTERM_INPUT, 6, 210, 246, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "&Send", IDC_LTERM_SEND, 256, 210, 44, 14
    PUSHBUTTON      "Close", IDCANCEL, 304, 210, 50, 14
END

IDD_APPROVE DIALOG 16, 16, 316, 214
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Approve Incoming Files (incoming\\ -> BBS files\\)"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Pending incoming files (Uploader / Filename / Size):", -1, 8, 8, 300, 10
    LISTBOX         IDC_APP_LIST, 8, 20, 300, 112, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Dest Subfolder:", -1, 8, 139, 58, 10
    EDITTEXT        IDC_APP_SUBDIR, 68, 137, 240, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Select a file to approve and move into the BBS files area.", IDC_APP_STATUS, 8, 156, 300, 12
    DEFPUSHBUTTON   "&Approve && Move", IDC_APP_APPROVE, 8, 174, 78, 14
    PUSHBUTTON      "&Delete / Reject", IDC_APP_DELETE, 92, 174, 74, 14
    PUSHBUTTON      "&Refresh", IDC_APP_REFRESH, 172, 174, 52, 14
    PUSHBUTTON      "Close", IDCANCEL, 252, 174, 56, 14
END

IDD_SETTINGS DIALOG 12, 12, 348, 204
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OYK Node Settings"
FONT 8, "MS Sans Serif"
BEGIN
    /* Top Tab Bar matching GTK tabs: Node | BBS | CHAT | Interfaces */
    PUSHBUTTON      "[ Node ]", IDC_SET_TAB_NODE, 6, 6, 64, 15
    PUSHBUTTON      "BBS", IDC_SET_TAB_BBS, 72, 6, 64, 15
    PUSHBUTTON      "CHAT", IDC_SET_TAB_CHAT, 138, 6, 64, 15
    PUSHBUTTON      "Interfaces", IDC_SET_TAB_IF, 204, 6, 72, 15

    GROUPBOX        "Node", IDC_SET_TAB_BOX, 6, 24, 336, 152

    /* Tab 1: Node */
    LTEXT           "Node Callsign (CALL-SSID):", IDC_SET_L_CALL, 14, 42, 92, 10
    EDITTEXT        IDC_SET_CALL, 110, 40, 110, 13, ES_UPPERCASE | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Node Alias:", IDC_SET_L_ALIAS, 14, 62, 92, 10
    EDITTEXT        IDC_SET_ALIAS, 110, 60, 110, 13, ES_UPPERCASE | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Welcome Message:", IDC_SET_L_WELC, 14, 82, 92, 10
    EDITTEXT        IDC_SET_WELCOME, 110, 80, 224, 13, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Info Message:", IDC_SET_L_INFO, 14, 102, 92, 10
    EDITTEXT        IDC_SET_INFO, 110, 100, 224, 13, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    CHECKBOX        "Allow incoming connections by default", IDC_SET_ACCEPT, 14, 124, 190, 11, BS_AUTOCHECKBOX | WS_TABSTOP

    /* Tab 2: BBS */
    CHECKBOX        "Enable Packet BBS", IDC_SET_BBS_EN, 14, 38, 120, 11, BS_AUTOCHECKBOX | WS_TABSTOP
    LTEXT           "BBS SSID (0-15):", IDC_SET_L_BSSID, 14, 56, 70, 10
    EDITTEXT        IDC_SET_BBS_SSID, 88, 54, 34, 13, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Callsign Override:", IDC_SET_L_BCALL, 130, 56, 62, 10
    EDITTEXT        IDC_SET_BBS_CALL, 196, 54, 64, 13, ES_UPPERCASE | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Alias:", IDC_SET_L_BALIAS, 266, 56, 20, 10
    EDITTEXT        IDC_SET_BBS_ALIAS, 288, 54, 46, 13, ES_UPPERCASE | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    CHECKBOX        "Enable BBS Files Area (FILES/GET/UPLOAD)", IDC_SET_FILES_EN, 14, 75, 190, 11, BS_AUTOCHECKBOX | WS_TABSTOP
    LTEXT           "Files Area Root Path:", IDC_SET_L_FPATH, 14, 94, 82, 10
    EDITTEXT        IDC_SET_FILES_PATH, 100, 92, 234, 13, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Mail Storage Path:", IDC_SET_L_MPATH, 14, 114, 82, 10
    EDITTEXT        IDC_SET_MAIL_PATH, 100, 112, 234, 13, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "BBS Welcome Msg:", IDC_SET_L_BWELC, 14, 134, 82, 10
    EDITTEXT        IDC_SET_BBS_WELC, 100, 132, 234, 13, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP

    /* Tab 3: CHAT */
    CHECKBOX        "Enable Multi-User CHAT Conference", IDC_SET_CHAT_EN, 14, 38, 170, 11, BS_AUTOCHECKBOX | WS_TABSTOP
    LTEXT           "CHAT SSID (0-15):", IDC_SET_L_CSSID, 14, 58, 70, 10
    EDITTEXT        IDC_SET_CHAT_SSID, 88, 56, 34, 13, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Callsign Override:", IDC_SET_L_CCALL, 130, 58, 62, 10
    EDITTEXT        IDC_SET_CHAT_CALL, 196, 56, 64, 13, ES_UPPERCASE | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Alias:", IDC_SET_L_CALIAS, 266, 58, 20, 10
    EDITTEXT        IDC_SET_CHAT_ALIAS, 288, 56, 46, 13, ES_UPPERCASE | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Default Topic:", IDC_SET_L_CTOP, 14, 80, 82, 10
    EDITTEXT        IDC_SET_CHAT_TOPIC, 100, 78, 120, 13, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "CHAT Welcome Msg:", IDC_SET_L_CWELC, 14, 102, 82, 10
    EDITTEXT        IDC_SET_CHAT_WELC, 100, 100, 234, 13, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP

    /* Tab 4: Interfaces */
    LTEXT           "Configured radio / network interface mappings:", IDC_SET_L_IF, 14, 38, 220, 10
    LISTBOX         IDC_SET_IF_LIST, 14, 52, 320, 94, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "&Add Interface...", IDC_SET_IF_ADD, 14, 152, 74, 15
    PUSHBUTTON      "&Remove Selected", IDC_SET_IF_REM, 94, 152, 78, 15

    DEFPUSHBUTTON   "&Save && Apply", IDOK, 206, 182, 68, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 278, 182, 64, 15
END

IDD_ADD_IFACE DIALOG 24, 24, 248, 142
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Interface Mapping"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Interface ID:", -1, 8, 10, 56, 10
    EDITTEXT        IDC_AIF_ID, 68, 8, 172, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Type:", -1, 8, 28, 56, 10
    COMBOBOX        IDC_AIF_TYPE, 68, 26, 172, 68, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Description:", -1, 8, 46, 56, 10
    EDITTEXT        IDC_AIF_DESC, 68, 44, 172, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Host / Device:", -1, 8, 64, 56, 10
    EDITTEXT        IDC_AIF_HOST, 68, 62, 172, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Port / Baud:", -1, 8, 82, 56, 10
    EDITTEXT        IDC_AIF_PORT, 68, 80, 172, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Peer (opt):", -1, 8, 100, 56, 10
    EDITTEXT        IDC_AIF_PEER, 68, 98, 172, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "Add", IDOK, 124, 120, 54, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 186, 120, 54, 14
END
