# OpenWatcom v2 / 1.9 WMAKE Makefile for 16-bit Windows 3.1 (Win16 + Winsock 1.1)
#
# Usage (Linux with OpenWatcom in /opt/watcom):
#   export WATCOM=/opt/watcom
#   export PATH=$WATCOM/binl64:$PATH
#   wmake -f makefile.win16

!ifndef WATCOM_DIR
!ifdef %WATCOM
WATCOM_DIR = $(%WATCOM)
!else
WATCOM_DIR = /opt/watcom
!endif
!endif

CC  = wpp
RC  = wrc
LD  = wlink

WIN_INC = -I$(WATCOM_DIR)/h -I$(WATCOM_DIR)/h/win
CFLAGS  = -2 -ml -zm -zt=512 -zw -os -bt=windows -wx -zq $(WIN_INC) -I../compat

OBJS = win_main.obj oyk_portable.obj oyk_yapp.obj oyk_rig.obj oyk_printer.obj oyk_term.obj oyk_gui.obj oyk_gui_theme.obj

all: oykw16.exe

win_main.obj: win_main.cpp resource.h ../compat/oyk_portable.hpp ../compat/oyk_yapp.hpp ../compat/oyk_rig.hpp ../compat/oyk_printer.hpp ../compat/oyk_term.hpp ../compat/oyk_gui.hpp
    $(CC) $(CFLAGS) -fo=win_main.obj win_main.cpp

oyk_portable.obj: ../compat/oyk_portable.cpp ../compat/oyk_portable.hpp
    $(CC) $(CFLAGS) -fo=oyk_portable.obj ../compat/oyk_portable.cpp

oyk_yapp.obj: ../compat/oyk_yapp.cpp ../compat/oyk_yapp.hpp ../compat/oyk_portable.hpp
    $(CC) $(CFLAGS) -fo=oyk_yapp.obj ../compat/oyk_yapp.cpp

oyk_rig.obj: ../compat/oyk_rig.cpp ../compat/oyk_rig.hpp ../compat/oyk_portable.hpp
    $(CC) $(CFLAGS) -fo=oyk_rig.obj ../compat/oyk_rig.cpp

oyk_printer.obj: ../compat/oyk_printer.cpp ../compat/oyk_printer.hpp
    $(CC) $(CFLAGS) -fo=oyk_printer.obj ../compat/oyk_printer.cpp

oyk_term.obj: ../compat/oyk_term.cpp ../compat/oyk_term.hpp ../compat/oyk_portable.hpp
    $(CC) $(CFLAGS) -fo=oyk_term.obj ../compat/oyk_term.cpp

oyk_gui.obj: ../compat/oyk_gui.cpp ../compat/oyk_gui.hpp ../compat/oyk_portable.hpp
    $(CC) $(CFLAGS) -fo=oyk_gui.obj ../compat/oyk_gui.cpp

oyk_gui_theme.obj: ../compat/oyk_gui_theme.cpp ../compat/oyk_gui.hpp ../compat/oyk_portable.hpp
    $(CC) $(CFLAGS) -fo=oyk_gui_theme.obj ../compat/oyk_gui_theme.cpp

oyk_win.res: oyk_win.rc resource.h
    $(RC) -bt=windows -q -r -i=$(WATCOM_DIR)/h/win -fo=oyk_win.res oyk_win.rc

oykw16.exe: $(OBJS) oyk_win.res
    $(LD) system windows option heapsize=16384,stack=8192 name oykw16.exe file { $(OBJS) } library winsock.lib,commdlg.lib
    $(RC) -bt=windows -q oyk_win.res oykw16.exe

clean: .SYMBOLIC
!ifdef __UNIX__
    rm -f *.o *.obj *.res *.err *.map oykw16.exe
!else
    del *.obj *.res *.err *.map oykw16.exe
!endif
