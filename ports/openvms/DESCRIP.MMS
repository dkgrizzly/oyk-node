# OpenVMS MMS / MMK build description for VAX, Alpha, IA64, and x86_64.

CC = CC
CFLAGS = /STANDARD=ANSI89 /INCLUDE=([-.SYSV], [.]) /DEFINE=(__VMS=1)
NETOPT = VMS_$(ARCH).OPT

SYSV_OBJS = SYSV_CORE.OBJ, SYSV_TUI.OBJ, SYSV_NET.OBJ

ALL : OYK_CONSOLE.EXE OYK_VMS_TEST.EXE
	@ WRITE SYS$OUTPUT "Built OpenVMS console and test targets."

SYSV_CORE.OBJ : [-.SYSV]SYSV_CORE.C [-.SYSV]SYSV_CORE.H
	$(CC) $(CFLAGS) /OBJECT=SYSV_CORE.OBJ [-.SYSV]SYSV_CORE.C

SYSV_TUI.OBJ : [-.SYSV]SYSV_TUI.C [-.SYSV]SYSV_TUI.H [-.SYSV]SYSV_LOGO_DATA.H
	$(CC) $(CFLAGS) /OBJECT=SYSV_TUI.OBJ [-.SYSV]SYSV_TUI.C

SYSV_NET.OBJ : [-.SYSV]SYSV_NET.C [-.SYSV]SYSV_NET.H
	$(CC) $(CFLAGS) /OBJECT=SYSV_NET.OBJ [-.SYSV]SYSV_NET.C

VMS_CONSOLE_MAIN.OBJ : VMS_CONSOLE_MAIN.C VMS_COMPAT.H [-.SYSV]SYSV_CORE.H
	$(CC) $(CFLAGS) /OBJECT=VMS_CONSOLE_MAIN.OBJ VMS_CONSOLE_MAIN.C

VMS_MOTIF_MAIN.OBJ : VMS_MOTIF_MAIN.C VMS_COMPAT.H [-.SYSV]SYSV_MOTIF_UI.H
	$(CC) $(CFLAGS) /DEFINE=(OYK_HAS_MOTIF=1) /OBJECT=VMS_MOTIF_MAIN.OBJ VMS_MOTIF_MAIN.C

TEST_VMS_NATIVE.OBJ : TEST_VMS_NATIVE.C VMS_COMPAT.H [-.SYSV]SYSV_CORE.H
	$(CC) $(CFLAGS) /OBJECT=TEST_VMS_NATIVE.OBJ TEST_VMS_NATIVE.C

SYSV_MOTIF_UI.OBJ : [-.SYSV]SYSV_MOTIF_UI.C [-.SYSV]SYSV_MOTIF_UI.H
	$(CC) $(CFLAGS) /DEFINE=(OYK_HAS_MOTIF=1) /OBJECT=SYSV_MOTIF_UI.OBJ [-.SYSV]SYSV_MOTIF_UI.C

OYK_CONSOLE.EXE : $(SYSV_OBJS), VMS_CONSOLE_MAIN.OBJ
	LINK /EXECUTABLE=OYK_CONSOLE.EXE $(SYSV_OBJS), VMS_CONSOLE_MAIN.OBJ, $(NETOPT)/OPTIONS

OYK_MOTIF.EXE : $(SYSV_OBJS), SYSV_MOTIF_UI.OBJ, VMS_MOTIF_MAIN.OBJ
	LINK /EXECUTABLE=OYK_MOTIF.EXE $(SYSV_OBJS), SYSV_MOTIF_UI.OBJ, VMS_MOTIF_MAIN.OBJ, $(NETOPT)/OPTIONS, DECW$XM_LINK/OPTIONS

OYK_VMS_TEST.EXE : $(SYSV_OBJS), TEST_VMS_NATIVE.OBJ
	LINK /EXECUTABLE=OYK_VMS_TEST.EXE $(SYSV_OBJS), TEST_VMS_NATIVE.OBJ, $(NETOPT)/OPTIONS
