$! SPDX-License-Identifier: GPL-3.0-or-later
$! Copyright (C) 2026 KR4OYK - David Kuder
$! DCL build script for OpenVMS VAX, Alpha, IA64, and x86_64.
$!
$ ARCH = F$EDIT(F$GETSYI("ARCH_NAME"), "UPCASE,TRIM")
$ IF ARCH .EQS. "" THEN ARCH = "VAX"
$ OPTFILE = "VMS_''ARCH'.OPT"
$ IF ARCH .EQS. "X86_64" THEN OPTFILE = "VMS_X86_64.OPT"
$ WRITE SYS$OUTPUT "Building OYK Packet Node for OpenVMS architecture: ''ARCH' (''OPTFILE')"
$ CC_CMD = "CC/STANDARD=ANSI89/PREFIX=ALL/WARNINGS=(DISABLE=(DOLLARID,LONGEXTERN))/INCLUDE=([-.SYSV],[.])"
$ IF ARCH .EQS. "VAX"
$ THEN
$   IF F$SEARCH("SYS$SYSTEM:DECC$*.EXE") .EQS. "" .AND. F$SEARCH("SYS$SYSTEM:VAXC.EXE") .NES. ""
$   THEN
$     CC_CMD = "CC/VAXC/INCLUDE=([-.SYSV],[.])"
$   ENDIF
$ ENDIF
$ 'CC_CMD' /OBJECT=SYSV_CORE.OBJ [-.SYSV]SYSV_CORE.C
$ 'CC_CMD' /OBJECT=SYSV_TUI.OBJ [-.SYSV]SYSV_TUI.C
$ 'CC_CMD' /OBJECT=SYSV_NET.OBJ [-.SYSV]SYSV_NET.C
$ 'CC_CMD' /OBJECT=VMS_CONSOLE_MAIN.OBJ VMS_CONSOLE_MAIN.C
$ 'CC_CMD' /OBJECT=TEST_VMS_NATIVE.OBJ TEST_VMS_NATIVE.C
$ LINK /EXECUTABLE=OYK_CONSOLE.EXE SYSV_CORE.OBJ,SYSV_TUI.OBJ,SYSV_NET.OBJ,VMS_CONSOLE_MAIN.OBJ,'OPTFILE'/OPTIONS
$ LINK /EXECUTABLE=OYK_VMS_TEST.EXE SYSV_CORE.OBJ,SYSV_TUI.OBJ,SYSV_NET.OBJ,TEST_VMS_NATIVE.OBJ,'OPTFILE'/OPTIONS
$ IF F$SEARCH("DECW$INCLUDE:XM.H") .NES. ""
$ THEN
$   'CC_CMD' /DEFINE=(OYK_HAS_MOTIF=1) /OBJECT=SYSV_MOTIF_UI.OBJ [-.SYSV]SYSV_MOTIF_UI.C
$   'CC_CMD' /DEFINE=(OYK_HAS_MOTIF=1) /OBJECT=VMS_MOTIF_MAIN.OBJ VMS_MOTIF_MAIN.C
$   LINK /EXECUTABLE=OYK_MOTIF.EXE SYSV_CORE.OBJ,SYSV_TUI.OBJ,SYSV_NET.OBJ,SYSV_MOTIF_UI.OBJ,VMS_MOTIF_MAIN.OBJ,'OPTFILE'/OPTIONS,VMS_MOTIF.OPT/OPTIONS
$ ENDIF
$ EXIT
